#!/usr/bin/env bash
# cmds — cheat sheet for all my tools, built live from ~/bin so it's never out of date
set -euo pipefail

# tools are found through the ~/bin symlinks that install.sh makes (<repo>/<name>/<name>),
# so tools from any repo show up, public or private, without naming the repos here
BIN="$HOME/bin"
declare -A SRC=()                           # tool name -> real script path
for link in "$BIN"/*; do
    [ -L "$link" ] || continue
    real=$(readlink -f "$link") || continue
    name="${link##*/}"
    [ -f "$real" ] && [ "$(basename "$(dirname "$real")")" = "$name" ] && SRC[$name]="$real"
done
unset link real name

usage() { cat <<'EOF'
Usage:
  cmds                list every tool with what it does
  cmds <tool>         that tool's full usage (e.g. cmds tidy)
  cmds all            every tool's usage on one page
  cmds find <word>    search all commands (e.g. cmds find undo)
  cmds tip            one random command to try
EOF
exit "${1:-0}"; }

B=$'\033[1m'; C=$'\033[1;36m'; G=$'\033[1;32m'; D=$'\033[2m'; X=$'\033[0m'

tools() { printf '%s\n' "${!SRC[@]}" | sort; }

# line 2 of every script: "# name — description"
describe() { sed -n '2s/^# [^ ]* — //p' "${SRC[$1]}"; }

# the usage heredoc, read from the source (not run, so nothing executes)
usage_of() {
    sed -n "/^usage() *{/,/^EOF/p" "${SRC[$1]}" | sed '1d;$d'
}

# folder holding the tool (for the README path), shown with ~
tool_dir() { local d; d=$(dirname "${SRC[$1]}"); echo "${d/#$HOME/\~}"; }

# just the command lines: "  tool args   description"
command_lines() {
    local t
    for t in $(tools); do usage_of "$t" | grep -E "^  $t( |$)" || true; done
}

list() {
    local t n
    n=$(tools | wc -l)
    echo
    echo "${B}your tools${X} ${D}($n · from ~/bin)${X}"
    echo
    for t in $(tools); do printf "  ${C}%-7s${X} %s\n" "$t" "$(describe "$t")"; done
    echo
    echo "  ${D}more:${X} ${G}cmds <tool>${X} full usage · ${G}cmds find <word>${X} search · ${G}cmds tip${X} random idea"
    echo
}

show() {
    local t="$1"
    printf "\n${C}%s${X} — %s\n\n" "$t" "$(describe "$t")"
    usage_of "$t"
    printf "\n${D}docs: %s/README.md${X}\n\n" "$(tool_dir "$t")"
}

find_cmd() {
    local hits
    hits=$(command_lines | grep -i -- "$1" || true)
    if [ -n "$hits" ]; then
        sed -E "s/^  ([a-z]+)/  ${C}\1${X}/" <<< "$hits"
    else
        echo "no command mentions \"$1\". Try: cmds"
    fi
}

tip() {
    # "tidy old [days] [dir]|files not modified in N days..." -> split on the 2+ space gap
    command_lines | shuf -n1 | sed -E 's/^ +//; s/ {2,}/|/'
}

case "${1:-}" in
    -h|--help) usage ;;
    "")        list ;;
    all)       for t in $(tools); do show "$t"; done ;;
    find)      [ -n "${2:-}" ] || usage 1 >&2; find_cmd "$2" ;;
    tip)       tip | sed 's/|/   /' ;;
    tip-raw)   tip ;;                                   # for motd: "command|description"
    *)
        if [ -n "${SRC[$1]:-}" ]; then show "$1"
        else echo "no tool called \"$1\". Your tools: $(tools | tr '\n' ' ')" >&2; exit 1; fi
        ;;
esac
