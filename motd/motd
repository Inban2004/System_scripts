#!/usr/bin/env bash
# motd — terminal greeting: random picture | info box (weather, system, focus) | cowsay fortune
set -euo pipefail

CITY="${MOTD_CITY:-}"                       # empty = wttr.in guesses from your IP
PICDIR="${MOTD_PICS:-$HOME/Pictures/motd}"  # drop .png/.jpg/.gif/.webp here
MODE="${MOTD_MODE:-auto}"                   # auto | pic | cow | both | none
PIC_SIZE="30x15"                            # chafa cells, roughly 240x240 px
BOX_W=44                                    # inner width of the info box
COW_W=28                                    # fortune wrap width for the cow on the right
WEATHER_TTL=1800                            # seconds before weather is fetched again
CACHEDIR="$HOME/.cache/motd"
mkdir -p "$CACHEDIR/pics"

usage() { cat <<'EOF'
Usage:
  motd                 picture | info box | cow (see MOTD_MODE)
  motd short           one-line version
  motd weather [city]  weather now (default: MOTD_CITY or auto-detect)
  motd cow             random cow with a fortune
  motd pic             random picture from the pics folder
  motd pics            list the pics folder (and pre-render them)

Environment:
  MOTD_CITY=Chennai   fixed weather city
  MOTD_PICS=dir       picture folder (default ~/Pictures/motd)
  MOTD_MODE=auto      auto/both (pic + box + cow) | pic | cow | none
EOF
exit "${1:-0}"; }

have() { command -v "$1" >/dev/null 2>&1; }

# ── data ─────────────────────────────────────────────────────────────
greeting() {
    local h; h=$(date +%-H)
    if   (( h < 5 ));  then echo "Still up? 🌙"
    elif (( h < 12 )); then echo "Good morning ☀️"
    elif (( h < 17 )); then echo "Good afternoon 🌤️"
    elif (( h < 21 )); then echo "Good evening 🌆"
    else                    echo "Good night 🌙"
    fi
}

weather_raw() {
    # prints "icon|temp|feels|condition|location", cached per city; empty if unavailable
    local city="${1:-$CITY}" cache url
    cache="$CACHEDIR/weather-${city:-auto}"
    cache="${cache// /_}"
    url="wttr.in/${city// /+}?format=%c|%t|%f|%C|%l"

    if [ -s "$cache" ] && (( $(date +%s) - $(stat -c %Y "$cache") < WEATHER_TTL )); then
        cat "$cache"; return
    fi
    if curl -fs -m 4 "$url" > "$cache.new" 2>/dev/null && grep -q '|' "$cache.new"; then
        mv "$cache.new" "$cache"
    else
        rm -f "$cache.new"          # offline: fall back to the old cache if there is one
    fi
    [ -s "$cache" ] && cat "$cache" || true
}

# split weather_raw into W_ICON W_TEMP W_FEELS W_COND W_LOC
load_weather() {
    local raw; raw=$(weather_raw "${1:-}")
    IFS='|' read -r W_ICON W_TEMP W_FEELS W_COND W_LOC <<< "$raw"
    W_ICON="${W_ICON%% *}"          # wttr pads the icon with spaces
    W_LOC="${W_LOC%%,*}"            # "Leeds, England, GB" -> "Leeds"
}

uptime_short() {
    local s d h m out=""
    read -r s _ < /proc/uptime; s=${s%.*}
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 ))
    (( d > 0 )) && out="${d}d "
    (( h > 0 )) && out+="${h}h "
    echo "${out}${m}m"
}

load_system() {
    S_RAM=$(free -h | awk '/^Mem:/ {print $7}')
    S_DISK=$(df -h / | awk 'NR==2 {print $5}')
    S_TEMP=$(sensors 2>/dev/null | awk '/Tctl|Package id 0/ {print $2; exit}' || true)
    S_UP=$(uptime_short)
}

focus_line() {
    # reshape "Today: 2 focus sessions, 50 min total" from tmr stats
    local out
    have tmr || { echo "tmr not installed"; return; }
    out=$(tmr stats 2>/dev/null || true)
    if [[ $out =~ Today:\ ([0-9]+)\ focus\ sessions,\ ([0-9]+)\ min ]]; then
        if (( BASH_REMATCH[1] == 0 )); then echo "nothing yet · try: tmr pomo"
        else echo "${BASH_REMATCH[1]} sessions · ${BASH_REMATCH[2]} min today"; fi
    else
        echo "nothing yet · try: tmr pomo"
    fi
}

# ── pictures ─────────────────────────────────────────────────────────
list_pics() {
    shopt -s nullglob nocaseglob
    PICS=("$PICDIR"/*.{png,jpg,jpeg,gif,webp})
    shopt -u nullglob nocaseglob
}

render_pic() {
    # $1 image -> cached chafa output on stdout
    local img="$1" key out
    key=$(printf '%s|%s|%s' "$img" "$(stat -c '%Y%s' "$img")" "$PIC_SIZE" | md5sum | cut -c1-16)
    out="$CACHEDIR/pics/$key"
    if [ ! -s "$out" ]; then
        chafa -f symbols --symbols block --size "$PIC_SIZE" \
              --polite on --animate off "$img" > "$out" 2>/dev/null || { rm -f "$out"; return 1; }
    fi
    cat "$out"
}

random_pic() {
    have chafa || return 1
    list_pics
    (( ${#PICS[@]} > 0 )) || return 1
    render_pic "${PICS[RANDOM % ${#PICS[@]}]}"
}

# ── drawing ──────────────────────────────────────────────────────────
# Box rows are drawn with absolute cursor columns (ESC[nG), so emoji of any
# width can't push the right border out of line.
C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOX=$'\033[38;5;244m'
C_HEAD=$'\033[1;35m'; C_DATE=$'\033[1;36m'
C_W=$'\033[1;33m'; C_S=$'\033[1;32m'; C_F=$'\033[1;34m'; C_T=$'\033[1;35m'

fortune_rows() {
    # short fortune, flattened and wrapped to fit inside the bubble (max 3 lines)
    have fortune || return 0
    fortune -s -n 120 2>/dev/null | tr -s '\n\t' '  ' | sed 's/ *$//' \
        | fold -s -w $(( BOX_W - 5 )) | head -3
}

build_rows() {
    # $1 = 1 to put a fortune inside the box (picture "says" it, cowsay-style)
    local with_fortune="${1:-0}" line first=1
    load_weather; load_system
    ROWS=(TOP
        "  ${C_HEAD}$(greeting)  $(whoami)${C_RESET}"
        "  ${C_DATE}$(date '+%A, %d %B %Y · %H:%M')${C_RESET}"
        SEP)
    if [ -n "$W_TEMP" ]; then
        ROWS+=("  ${C_W}weather${C_RESET}  ${W_ICON} ${W_TEMP} ${C_DIM}(feels ${W_FEELS})${C_RESET}"
               "           ${W_COND} · ${W_LOC}")
    else
        ROWS+=("  ${C_W}weather${C_RESET}  ${C_DIM}unavailable (offline?)${C_RESET}")
    fi
    ROWS+=("  ${C_S}system${C_RESET}   RAM ${S_RAM} free · disk ${S_DISK}"
           "           CPU ${S_TEMP:-n/a} · up ${S_UP}"
           "  ${C_F}focus${C_RESET}    $(focus_line)")
    # a random command from `cmds`, so the tools don't get forgotten
    if have cmds; then
        local tip tcmd tdesc max=$(( BOX_W - 12 ))
        tip=$(cmds tip-raw 2>/dev/null || true)
        tcmd="${tip%%|*}"; tdesc="${tip#*|}"
        (( ${#tcmd} > max )) && tcmd="${tcmd:0:max-1}…"
        (( ${#tdesc} > max )) && tdesc="${tdesc:0:max-1}…"
        [ -n "$tip" ] && ROWS+=("  ${C_T}tip${C_RESET}      ${tcmd}"
                                "           ${C_DIM}${tdesc}${C_RESET}")
    fi
    if (( with_fortune )); then
        ROWS+=(SEP)
        while IFS= read -r line || [ -n "$line" ]; do   # fold leaves no final newline
            if (( first )); then ROWS+=("  💬 ${C_DIM}${line}${C_RESET}"); first=0
            else                 ROWS+=("     ${C_DIM}${line}${C_RESET}"); fi
        done < <(fortune_rows)
    fi
    ROWS+=(BOT)
}

box_row() {
    # $1 row, $2 left column of the box, $3 = 1 to draw the speech tail on this row
    local row="$1" col="$2" right=$(( $2 + BOX_W + 1 )) hr
    printf -v hr '%*s' "$BOX_W" ''; hr="${hr// /─}"
    if [ "${3:-0}" = 1 ]; then
        printf '\033[%dG%s◀─┤%s' $(( col - 2 )) "$C_BOX" "$C_RESET"
        printf '%s\033[%dG%s│%s' "$row" "$right" "$C_BOX" "$C_RESET"
        return
    fi
    case "$row" in
        TOP) printf '\033[%dG%s╭%s╮%s' "$col" "$C_BOX" "$hr" "$C_RESET" ;;
        SEP) printf '\033[%dG%s├%s┤%s' "$col" "$C_BOX" "$hr" "$C_RESET" ;;
        BOT) printf '\033[%dG%s╰%s╯%s' "$col" "$C_BOX" "$hr" "$C_RESET" ;;
        *)   printf '\033[%dG%s│%s%s\033[%dG%s│%s' \
                 "$col" "$C_BOX" "$C_RESET" "$row" "$right" "$C_BOX" "$C_RESET" ;;
    esac
}

draw() {
    local pic="" show_pic=0 show_cow=0 cols pw=0 cw=0 left cowcol i n
    local off_p=0 off_b=0 off_c=0 cow_below=0 tail=-1 cowtxt=""
    local -a PL=() CL=()

    list_pics
    case "$MODE" in
        auto|both) show_cow=1; (( ${#PICS[@]} > 0 )) && have chafa && show_pic=1 ;;
        pic)       show_pic=1 ;;
        cow)       show_cow=1 ;;
        none)      ;;
        *)         echo "bad MOTD_MODE: $MODE" >&2; exit 1 ;;
    esac
    if (( show_pic )); then
        pic=$(random_pic || true)
        [ -n "$pic" ] && mapfile -t PL <<< "$pic"
        (( ${#PL[@]} > 0 )) && pw=$(sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' <<< "$pic" | wc -L)
    fi

    # fortune goes inside the box only when no cow is there to say it
    build_rows $(( ${#PL[@]} > 0 && ! show_cow ))
    cols=$(tput cols 2>/dev/null || echo 80)

    # picture | box side by side if both fit, else stacked
    if (( ${#PL[@]} > 0 )) && (( pw + 5 + BOX_W + 2 <= cols )); then
        left=$(( pw + 6 ))                              # 2-col gap + "◀─" tail
    else
        left=2
    fi
    cowcol=$(( left + BOX_W + 5 ))

    # cow to the right of the box if one fits in the space left, else below
    if (( show_cow )); then
        cowtxt=$(cow_fit $(( cols - cowcol )) || true)
        if [ -n "$cowtxt" ]; then
            mapfile -t CL <<< "$cowtxt"
        else
            cow_below=1
        fi
    fi

    echo
    if (( left == 2 )); then
        for line in "${PL[@]}"; do printf ' %s%s\n' "$line" "$C_RESET"; done
        PL=()
    fi

    # print the side-by-side blocks row by row, each centred vertically
    n=${#ROWS[@]}
    (( ${#PL[@]} > n )) && n=${#PL[@]}
    (( ${#CL[@]} > n )) && n=${#CL[@]}
    off_p=$(( (n - ${#PL[@]}) / 2 )); off_b=$(( (n - ${#ROWS[@]}) / 2 )); off_c=$(( (n - ${#CL[@]}) / 2 ))
    if (( ${#PL[@]} > 0 )); then
        tail=$(( off_p + ${#PL[@]} / 2 - off_b ))      # box row level with the picture's middle
        (( tail < 1 )) && tail=1
        (( tail > ${#ROWS[@]} - 2 )) && tail=$(( ${#ROWS[@]} - 2 ))
        [[ ${ROWS[tail]} =~ ^(TOP|SEP|BOT)$ ]] && tail=$(( tail + 1 ))
    fi
    for (( i = 0; i < n; i++ )); do
        local p=$(( i - off_p )) b=$(( i - off_b )) c=$(( i - off_c ))
        printf ' '
        if (( p >= 0 && p < ${#PL[@]} )); then printf '%s%s' "${PL[p]}" "$C_RESET"; fi
        if (( b >= 0 && b < ${#ROWS[@]} )); then box_row "${ROWS[b]}" "$left" $(( b == tail )); fi
        if (( c >= 0 && c < ${#CL[@]} )); then printf '\033[%dG%s' "$cowcol" "${CL[c]}"; fi
        printf '\n'
    done

    if (( cow_below )); then echo; cow; fi
}

cow_names() {
    # this cowsay lists one name per line; drop any "Cow files in ...:" header
    cowsay -l | grep -v ':' | tr ' ' '\n' | grep -v '^$'
}

cow_widths() {
    # cached "name<TAB>art width" for every cow, so picking one needs a single cowsay call
    local cache="$CACHEDIR/cows.tsv" c
    if [ ! -s "$cache" ]; then
        while read -r c; do
            printf '%s\t%s\n' "$c" "$(cowsay -f "$c" x 2>/dev/null | tail -n +4 | wc -L)"
        done < <(cow_names) > "$cache"
    fi
    cat "$cache"
}

cow_fit() {
    # $1 = columns available; prints a random cow + fortune no wider than that
    local maxw="$1" name out
    have fortune && have cowsay || return 1
    (( maxw >= COW_W + 4 )) || return 1               # the speech bubble alone needs this
    name=$(cow_widths | awk -F'\t' -v m="$maxw" '$2 <= m {print $1}' | shuf -n1)
    [ -n "$name" ] || return 1
    out=$(fortune -s -n 100 | cowsay -W "$COW_W" -f "$name")
    (( $(wc -L <<< "$out") <= maxw )) || return 1
    printf '%s\n' "$out"
}

cow() {
    have fortune || { echo "install fortune-mod for fortunes"; return; }
    if have cowsay; then
        local cows; mapfile -t cows < <(cow_names)
        fortune -s | cowsay -f "${cows[RANDOM % ${#cows[@]}]}"
    else
        fortune -s
    fi
}

# ── dispatcher ───────────────────────────────────────────────────────
case "${1:-full}" in
    -h|--help) usage ;;
    full) draw ;;
    short)
        load_weather "${2:-}"; load_system
        printf '%s · %s %s %s · RAM %s free · up %s\n' "$(date '+%a %H:%M')" \
            "${W_ICON:-}" "${W_TEMP:-weather n/a}" "${W_COND:-}" "$S_RAM" "$S_UP"
        ;;
    weather)
        load_weather "${2:-}"
        if [ -n "$W_TEMP" ]; then
            echo "${W_LOC}: ${W_ICON} ${W_TEMP} (feels ${W_FEELS}), ${W_COND}"
        else
            echo "weather unavailable"
        fi
        ;;
    cow) cow ;;
    pic)
        have chafa || { echo "chafa not installed (sudo dnf install chafa)" >&2; exit 1; }
        random_pic || { echo "no pictures in $PICDIR" >&2; exit 1; }
        ;;
    pics)
        list_pics
        echo "$PICDIR: ${#PICS[@]} picture(s)"
        # also pre-renders each one, so a new picture never slows a terminal open
        for f in "${PICS[@]}"; do
            echo "  ${f##*/}"
            if have chafa; then render_pic "$f" >/dev/null || echo "    (chafa could not read this)"; fi
        done
        [ -d "$PICDIR" ] || echo "  (folder missing: mkdir -p $PICDIR)"
        ;;
    *) echo "unknown subcommand: $1" >&2; usage 1 >&2 ;;
esac
