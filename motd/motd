#!/usr/bin/env bash
# motd — terminal greeting: time, weather, quick system line, focus stats, a fortune
set -euo pipefail

CACHEDIR="$HOME/.cache/motd"
WEATHER_TTL=1800                            # seconds before weather is fetched again
WEATHER_FMT='%l:+%c+%t+(feels+%f),+%C'      # wttr.in format codes
mkdir -p "$CACHEDIR"

usage() { cat <<'EOF'
Usage:
  motd                full greeting (default)
  motd short          one-line version, no cow
  motd weather [city] weather now (default: auto-detect from IP)
  motd cow            just a random cow with a fortune
EOF
exit "${1:-0}"; }

banner() { printf '\033[1;%sm%s\033[0m\n' "$2" "$1"; }
have()   { command -v "$1" >/dev/null 2>&1; }

# ── pieces ───────────────────────────────────────────────────────────
greeting() {
    local h; h=$(date +%-H)
    if   (( h < 5 ));  then echo "Still up? 🌙"
    elif (( h < 12 )); then echo "Good morning ☀️"
    elif (( h < 17 )); then echo "Good afternoon 🌤️"
    elif (( h < 21 )); then echo "Good evening 🌆"
    else                    echo "Good night 🌙"
    fi
}

weather() {
    # $1 optional city; auto-location is cached, explicit cities are not
    local city="${1:-}" cache="$CACHEDIR/weather"
    if [ -n "$city" ]; then
        curl -fs -m 4 "wttr.in/${city// /+}?format=$WEATHER_FMT" || echo "weather unavailable"
        echo; return
    fi
    if [ -s "$cache" ] && (( $(date +%s) - $(stat -c %Y "$cache") < WEATHER_TTL )); then
        cat "$cache"; return
    fi
    if curl -fs -m 4 "wttr.in/?format=$WEATHER_FMT" > "$cache.new" && [ -s "$cache.new" ]; then
        mv "$cache.new" "$cache"; echo >> "$cache"; cat "$cache"
    else
        rm -f "$cache.new"
        [ -s "$cache" ] && cat "$cache" || echo "weather unavailable (offline?)"
    fi
}

sysline() {
    local avail disk temp up
    avail=$(free -h | awk '/^Mem:/ {print $7}')
    disk=$(df -h / | awk 'NR==2 {print $5}')
    temp=$(sensors 2>/dev/null | awk '/Tctl|Package id 0/ {print $2; exit}' || true)
    up=$(uptime -p | sed 's/^up //')
    printf 'RAM free %s · disk %s used · %s · up %s\n' "$avail" "$disk" "${temp:-temp n/a}" "$up"
}

focus() {
    have tmr && tmr stats 2>/dev/null || echo "tmr not installed"
}

cow() {
    have fortune || { echo "install fortune-mod for fortunes"; return; }
    if have cowsay; then
        local cows; mapfile -t cows < <(cowsay -l | grep -v ':' | tr ' ' '\n' | grep -v '^$')
        fortune -s | cowsay -f "${cows[RANDOM % ${#cows[@]}]}"
    else
        fortune -s
    fi
}

# ── dispatcher ───────────────────────────────────────────────────────
case "${1:-full}" in
    -h|--help) usage ;;
    full)
        echo
        banner "$(greeting)  $(whoami)" 35
        banner "$(date '+%A, %d %B %Y · %H:%M')" 36
        echo
        printf '\033[1;33m%-8s\033[0m %s\n' "weather" "$(weather)"
        printf '\033[1;32m%-8s\033[0m %s\n' "system"  "$(sysline)"
        printf '\033[1;34m%-8s\033[0m %s\n' "focus"   "$(focus)"
        echo
        cow
        ;;
    short)   printf '%s · %s · %s\n' "$(date '+%a %H:%M')" "$(weather)" "$(sysline)" ;;
    weather) weather "${2:-}" ;;
    cow)     cow ;;
    *)       echo "unknown subcommand: $1" >&2; usage 1 >&2 ;;
esac
