#!/usr/bin/env bash
# sys — Fedora system health, maintenance and cleanup dispatcher
set -euo pipefail

LOGDIR="$HOME/.local/share/sys"
LOGFILE="$LOGDIR/health.tsv"
JOURNAL_KEEP="7d"          # how much journal history to retain on clean
mkdir -p "$LOGDIR"

# ── helpers ──────────────────────────────────────────────────────────
banner() { printf '\n\033[1;%sm── %s\033[0m\n' "$2" "$1"; }
have()   { command -v "$1" >/dev/null 2>&1; }

confirm() {
    read -rp "$(printf '\033[1;33m%s [y/N] \033[0m' "$1")" ans
    [[ ${ans,,} == y* ]]
}

usage() { cat <<'EOF'
Usage:
  sys              health snapshot (default)
  sys health       memory, swap, pressure, disk, temps, uptime
  sys mem          top 10 processes by RSS
  sys update       dnf + flatpak + firmware updates
  sys clean        remove orphans, caches, old journals  (asks first)
  sys net          IP, gateway, DNS, connectivity
  sys big [path]   10 largest directories (default: $HOME)
  sys boot         boot time breakdown
  sys snap         append a health line to the log
  sys log          show logged snapshots
EOF
exit "${1:-0}"; }

# ── subcommand bodies ────────────────────────────────────────────────
health() {
    banner "Memory" 32
    free -h

    banner "Swap / zram" 32
    swapon --show || echo "no swap active"
    have zramctl && zramctl || true

    banner "Memory pressure" 32
    # avg10 climbing above ~10 means real stalling
    cat /proc/pressure/memory 2>/dev/null || echo "PSI unavailable"

    banner "Disk" 32
    # btrfs: / and /home share one device, so show each device once
    df -h / /home 2>/dev/null | awk '!seen[$1]++'

    banner "Temperature" 32
    if have sensors; then
        sensors 2>/dev/null | grep -Ei 'Package|Core 0|Tctl' || sensors
    else
        echo "lm_sensors not installed (sudo dnf install lm_sensors)"
    fi

    banner "Uptime" 32
    uptime -p
}

mem() {
    banner "Top 10 by resident memory" 36
    # comm goes last: names can contain spaces ("Isolated Web Co")
    ps -eo pid,rss,comm --sort=-rss 2>/dev/null | head -11 \
        | awk 'NR==1 {printf "%-8s %-25s %s\n", "PID", "COMMAND", "RSS"; next}
               {pid=$1; rss=$2; $1=$2=""; sub(/^ +/, "")
                printf "%-8s %-25s %.0f MB\n", pid, $0, rss/1024}' || true

    banner "Totals by process name" 36
    ps -eo rss,comm --no-headers 2>/dev/null \
        | awk '{rss=$1; $1=""; sub(/^ +/, ""); a[$0]+=rss}
               END {for (k in a) printf "%.0f\t%s\n", a[k]/1024, k}' \
        | sort -rn | head -10 \
        | awk -F'\t' '{printf "%-25s %s MB\n", $2, $1}' || true
}

update() {
    banner "DNF" 33
    sudo dnf upgrade --refresh

    if have flatpak; then
        banner "Flatpak" 33
        flatpak update
    fi

    if have fwupdmgr; then
        banner "Firmware" 33
        sudo fwupdmgr refresh --force || true
        sudo fwupdmgr get-updates || echo "no firmware updates"
    fi

    banner "Reboot needed?" 33
    # dnf5 ships needs-restarting as a subcommand; -C = use cache, no re-download
    dnf -C needs-restarting 2>/dev/null || true
}

clean() {
    banner "Current reclaimable space" 35
    du -sh /var/cache/dnf ~/.cache 2>/dev/null || true
    journalctl --disk-usage 2>/dev/null || true

    echo
    confirm "Remove orphaned packages, caches and journals older than $JOURNAL_KEEP?" || {
        echo "Aborted."; return 0; }

    banner "Orphaned packages" 35
    sudo dnf autoremove -y

    banner "DNF cache" 35
    sudo dnf clean all

    if have flatpak; then
        banner "Unused flatpak runtimes" 35
        flatpak uninstall --unused -y || true
    fi

    banner "Journal" 35
    sudo journalctl --vacuum-time="$JOURNAL_KEEP"

    banner "Thumbnail cache" 35
    rm -rf "$HOME/.cache/thumbnails"/* 2>/dev/null || true
    echo "cleared"

    banner "Done — new state" 35
    df -h / | tail -1
}

net() {
    banner "Interfaces" 36
    ip -brief addr

    banner "Default route" 36
    ip route | grep '^default' || echo "no default route"

    banner "DNS" 36
    if have resolvectl; then
        resolvectl status | grep -E 'DNS Servers|Current DNS' || true
    else
        cat /etc/resolv.conf | grep nameserver
    fi

    banner "Connectivity" 36
    ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 \
        && echo "IPv4 reachable" || echo "IPv4 FAILED"
    getent hosts fedoraproject.org >/dev/null 2>&1 \
        && echo "DNS resolving" || echo "DNS FAILED"
}

big() {
    local target="${1:-$HOME}"
    banner "10 largest directories in $target" 36
    du -h --max-depth=2 "$target" 2>/dev/null | sort -rh | head -10 || true
}

boot() {
    banner "Boot time" 36
    systemd-analyze

    banner "Slowest units" 36
    systemd-analyze blame 2>/dev/null | head -10 || true

    banner "Failed units" 36
    systemctl --failed --no-pager || true
}

snap() {
    local avail used swap
    avail=$(free -m | awk '/^Mem:/ {print $7}')
    used=$(free -m  | awk '/^Mem:/ {print $3}')
    swap=$(free -m  | awk '/^Swap:/ {print $3}')
    printf '%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" \
        "used=${used}M" "avail=${avail}M" "swap=${swap}M" >> "$LOGFILE"
    echo "logged: used=${used}M avail=${avail}M swap=${swap}M"
}

showlog() {
    if [ -s "$LOGFILE" ]; then
        tail -20 "$LOGFILE" | column -t -s $'\t'
    else
        echo "No snapshots logged yet. Run: sys snap"
    fi
}

# ── dispatcher ───────────────────────────────────────────────────────
case "${1:-health}" in
    -h|--help) usage ;;
    health)    health ;;
    mem)       mem ;;
    update)    update ;;
    clean)     clean ;;
    net)       net ;;
    big)       big "${2:-$HOME}" ;;
    boot)      boot ;;
    snap)      snap ;;
    log)       showlog ;;
    *)         echo "unknown subcommand: $1" >&2; usage 1 >&2 ;;
esac
