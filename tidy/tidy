#!/usr/bin/env bash
# tidy — sort a messy folder (default ~/Downloads) into type folders; dry run first, undo anytime
set -euo pipefail

LOGDIR="$HOME/.local/share/tidy"
mkdir -p "$LOGDIR"

# category -> extensions (lowercase). Anything not listed is left where it is.
declare -A CATS=(
    [Images]="jpg jpeg png gif webp svg bmp tif tiff heic ico avif"
    [Videos]="mp4 mkv webm mov avi m4v"
    [Audio]="mp3 wav flac ogg m4a opus aac"
    [Documents]="pdf doc docx odt rtf txt md epub"
    [Slides]="ppt pptx odp key"
    [Sheets]="xls xlsx ods csv"
    [Diagrams]="drawio puml dia vsdx"
    [Archives]="zip gz tgz bz2 xz 7z rar tar zst"
    [Installers]="rpm deb iso appimage flatpakref exe msi run"
    [Code]="sh py c cpp h js ts json html css java go rs ipynb yml yaml"
    [Fonts]="ttf otf woff woff2"
)
ORDER=(Images Videos Audio Documents Slides Sheets Diagrams Archives Installers Code Fonts)
SKIP_EXT="part crdownload tmp download"   # unfinished downloads: never touch

usage() { cat <<'EOF'
Usage:
  tidy [dir]            dry run: show what would move where (default ~/Downloads)
  tidy -v [dir]         dry run listing every file
  tidy go [dir]         actually move the files (logged, undoable)
  tidy undo             put back everything from the last `tidy go`
  tidy history          past runs
  tidy old [days] [dir] files not modified in N days (default 90); lists only, never deletes

Leaves alone: folders, hidden files, unfinished downloads (.part...), unknown types.
EOF
exit "${1:-0}"; }

B=$'\033[1m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; C=$'\033[1;36m'; D=$'\033[2m'; X=$'\033[0m'

declare -A EXT2CAT=()
for cat in "${!CATS[@]}"; do
    for e in ${CATS[$cat]}; do EXT2CAT[$e]=$cat; done
done

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }

# category for a file name, or empty = leave it
category() {
    local name="$1" ext
    [[ $name == .* || $name != *.* ]] && return 0
    ext="${name##*.}"; ext="${ext,,}"
    [[ " $SKIP_EXT " == *" $ext "* ]] && return 0
    echo "${EXT2CAT[$ext]:-}"
}

# free destination path: "name.ext", then "name (1).ext", ...
free_name() {
    local dir="$1" name="$2" base ext n=1 try
    try="$dir/$name"
    [ -e "$try" ] || { echo "$try"; return; }
    if [[ $name == *.* ]]; then base="${name%.*}"; ext=".${name##*.}"; else base="$name"; ext=""; fi
    while [ -e "$dir/$base ($n)$ext" ]; do n=$(( n + 1 )); done
    echo "$dir/$base ($n)$ext"
}

# fills PLAN_SRC / PLAN_CAT for the top-level files of $1, plus skipped counts
scan() {
    local dir="$1" f name cat
    PLAN_SRC=(); PLAN_CAT=(); PLAN_SIZE=(); SKIPPED=0; UNKNOWN=()
    while IFS= read -r -d '' f; do
        name="${f##*/}"
        cat=$(category "$name")
        if [ -n "$cat" ]; then
            PLAN_SRC+=("$f"); PLAN_CAT+=("$cat"); PLAN_SIZE+=("$(stat -c %s "$f")")
        elif [[ $name == .* ]] || [[ " $SKIP_EXT " == *" ${name##*.} "* ]]; then
            SKIPPED=$(( SKIPPED + 1 ))
        else
            UNKNOWN+=("$name")
        fi
    done < <(find "$dir" -maxdepth 1 -type f -print0 | sort -z)
}

summary() {
    # $1 = 1 to list every file
    local verbose="$1" cat i n size total_n=0 total_size=0
    for cat in "${ORDER[@]}"; do
        n=0; size=0
        for i in "${!PLAN_CAT[@]}"; do
            [ "${PLAN_CAT[i]}" = "$cat" ] || continue
            n=$(( n + 1 )); size=$(( size + PLAN_SIZE[i] ))   # sizes from scan: files may be moved already
        done
        (( n > 0 )) || continue
        printf "  ${C}%-11s${X} %4d files  %8s\n" "$cat/" "$n" "$(human $size)"
        if (( verbose )); then
            for i in "${!PLAN_CAT[@]}"; do
                [ "${PLAN_CAT[i]}" = "$cat" ] && printf "  ${D}            %s${X}\n" "${PLAN_SRC[i]##*/}"
            done
        fi
        total_n=$(( total_n + n )); total_size=$(( total_size + size ))
    done
    printf "  ${B}%-11s %4d files  %8s${X}\n" "total" "$total_n" "$(human $total_size)"
    echo
    (( ${#UNKNOWN[@]} > 0 )) && printf "  ${Y}left alone${X} (unknown type): %s\n" "$(printf '%s, ' "${UNKNOWN[@]}" | sed 's/, $//')"
    (( SKIPPED > 0 )) && printf "  ${Y}left alone${X} (hidden / unfinished): %d files\n" "$SKIPPED"
    return 0
}

plan() {
    local dir="$1" verbose="$2"
    scan "$dir"
    echo "${B}tidy plan for $dir${X} ${D}(dry run — nothing moved)${X}"
    echo
    if (( ${#PLAN_SRC[@]} == 0 )); then echo "  nothing to tidy ✨"; return; fi
    summary "$verbose"
    echo
    local arg=""; [ "$dir" = "$HOME/Downloads" ] || arg=" $(printf '%q' "$dir")"
    echo "  run ${G}tidy go${arg}${X} to move them · ${G}tidy undo${X} reverses it"
}

go() {
    local dir="$1" i dest log moved=0
    scan "$dir"
    if (( ${#PLAN_SRC[@]} == 0 )); then echo "nothing to tidy ✨"; return; fi
    log="$LOGDIR/moves-$(date +%Y%m%d-%H%M%S)-$$.tsv"     # pid keeps same-second runs apart
    for i in "${!PLAN_SRC[@]}"; do
        mkdir -p "$dir/${PLAN_CAT[i]}"
        dest=$(free_name "$dir/${PLAN_CAT[i]}" "${PLAN_SRC[i]##*/}")
        mv -n -- "${PLAN_SRC[i]}" "$dest"
        printf '%s\t%s\n' "${PLAN_SRC[i]}" "$dest" >> "$log"   # logged per file, so undo works even after a crash
        moved=$(( moved + 1 ))
    done
    summary 0
    echo "  ${G}moved $moved files.${X} undo with: tidy undo"
}

undo() {
    local log src dest back=0 missing=0
    log=$(ls -1t "$LOGDIR"/moves-*.tsv 2>/dev/null | grep -v '\.undone\.tsv$' | head -1 || true)
    [ -n "$log" ] || { echo "nothing to undo."; return; }
    echo "undoing $(basename "$log") ($(wc -l < "$log") moves)"
    # reverse order, so later moves are undone first
    while IFS=$'\t' read -r src dest; do
        if [ -e "$dest" ] && [ ! -e "$src" ]; then
            mv -n -- "$dest" "$src"; back=$(( back + 1 ))
        else
            if [ -e "$dest" ]; then echo "  ${Y}skip${X} ${src##*/}: that name is taken again; file left at ${dest#"${src%/*}"/}"
            else echo "  ${Y}skip${X} ${dest##*/}: no longer there (moved or deleted since)"; fi
            missing=$(( missing + 1 ))
        fi
    done < <(tac "$log")
    # remove the category folders this run created, if they're empty now
    cut -f2 "$log" | xargs -d '\n' -n1 dirname | sort -u | xargs -d '\n' rmdir --ignore-fail-on-non-empty 2>/dev/null || true
    mv "$log" "${log%.tsv}.undone.tsv"
    echo "${G}restored $back files${X}$( (( missing )) && echo ", skipped $missing" )."
}

history() {
    local f n
    shopt -s nullglob
    local logs=("$LOGDIR"/moves-*.tsv)
    (( ${#logs[@]} )) || { echo "no runs yet."; return; }
    for f in "${logs[@]}"; do
        n=$(wc -l < "$f")
        [[ $f == *.undone.tsv ]] && printf '%s  %4d files  %s\n' "$(basename "$f" .undone.tsv | sed 's/moves-//; s/-[0-9]*$//')" "$n" "${D}(undone)${X}" \
                                 || printf '%s  %4d files\n' "$(basename "$f" .tsv | sed 's/moves-//; s/-[0-9]*$//')" "$n"
    done
}

old() {
    local days="$1" dir="$2" list
    echo "${B}files in $dir not modified in $days+ days${X} ${D}(nothing is deleted)${X}"
    list=$(find "$dir" -maxdepth 2 -type f -not -name '.*' -mtime +"$days" -printf '%s\t%TY-%Tm-%Td\t%P\n' | sort -rn)
    [ -n "$list" ] || { echo "  none ✨"; return; }
    head -25 <<< "$list" | while IFS=$'\t' read -r size date name; do
        printf '  %8s  %s  %s\n' "$(human "$size")" "$date" "$name"
    done
    awk -F'\t' '{n++; s+=$1} END {print n, s}' <<< "$list" | {
        read -r n s; echo "  ${B}total: $n files, $(human "$s")${X}$( (( n > 25 )) && echo " (showing biggest 25)")"; }
}

dir_arg() {
    local d="${1:-$HOME/Downloads}"
    [ -d "$d" ] || { echo "not a folder: $d" >&2; exit 1; }
    (cd "$d" && pwd)
}

# ── dispatcher ───────────────────────────────────────────────────────
# (the folder is resolved into a variable first: an `exit` inside "$(...)" would only leave the subshell)
case "${1:-}" in
    -h|--help) usage ;;
    -v)        DIR=$(dir_arg "${2:-}"); plan "$DIR" 1 ;;
    go)        DIR=$(dir_arg "${2:-}"); go "$DIR" ;;
    undo)      undo ;;
    history)   history ;;
    old)
        if [[ ${2:-} =~ ^[0-9]+$ ]]; then DIR=$(dir_arg "${3:-}"); old "$2" "$DIR"
        else DIR=$(dir_arg "${2:-}"); old 90 "$DIR"; fi
        ;;
    -*)        echo "unknown option: $1" >&2; usage 1 >&2 ;;
    *)         DIR=$(dir_arg "${1:-}"); plan "$DIR" 0 ;;
esac
