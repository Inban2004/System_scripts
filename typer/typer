#!/usr/bin/env bash
# typer — terminal typing-speed game: live coloring, WPM + accuracy, best scores
set -euo pipefail

LOGDIR="$HOME/.local/share/typer"
LOGFILE="$LOGDIR/scores.tsv"
MAXLEN=90                                   # longest sentence (must fit on one line)
mkdir -p "$LOGDIR"

# fallback sentences when fortune isn't installed (or gives nothing short enough)
SENTENCES=(
    "The quick brown fox jumps over the lazy dog."
    "Pack my box with five dozen liquor jugs."
    "Fedora updates arrive faster than my coffee gets cold."
    "A terminal a day keeps the mouse away."
    "Small scripts grow into tools you use every single day."
    "Never trust a computer you cannot throw out of a window."
    "Focus for twenty five minutes, then stretch your legs."
    "Real programmers count from zero and sleep at sunrise."
)

usage() { cat <<'EOF'
Usage:
  typer               one round with a random sentence
  typer 5             five rounds in a row
  typer -t "text"     type your own text
  typer best          top 10 scores
  typer stats         today, all-time best, last 20 rounds as a graph
  typer log           last 20 rounds

Keys: type the sentence · Backspace fixes · Esc or Ctrl+C quits
EOF
exit "${1:-0}"; }

# ── helpers ──────────────────────────────────────────────────────────
G=$'\033[1;32m'; R=$'\033[1;41;97m'; D=$'\033[2m'; U=$'\033[4m'
Y=$'\033[1;33m'; C=$'\033[1;36m'; M=$'\033[1;35m'; X=$'\033[0m'

now_us() { local t="$EPOCHREALTIME"; echo "${t/./}"; }   # microseconds, no fork

pick_sentence() {
    local cols max s
    cols=$(tput cols 2>/dev/null || echo 80)
    max=$(( cols - 4 < MAXLEN ? cols - 4 : MAXLEN ))
    if command -v fortune >/dev/null; then
        # a few tries for a short, plain-ASCII, one-line fortune
        for _ in 1 2 3 4 5 6; do
            s=$(fortune -s -n "$max" 2>/dev/null | tr -s '\n\t' '  ' | sed 's/^ *//; s/ *$//; s/  */ /g')
            if (( ${#s} >= 25 && ${#s} <= max )) && [[ $s =~ ^[[:print:]]+$ ]] \
               && ! LC_ALL=C grep -q '[^ -~]' <<< "$s"; then
                echo "$s"; return
            fi
        done
    fi
    echo "${SENTENCES[RANDOM % ${#SENTENCES[@]}]}"
}

# repaint the sentence: typed part green/red, cursor underlined, rest dim
paint() {
    local target="$1" typed="$2" i out="" t c
    for (( i = 0; i < ${#typed}; i++ )); do
        t="${target:i:1}"; c="${typed:i:1}"
        if [[ $c == "$t" ]]; then out+="${G}${t}${X}"
        else out+="${R}${t/ /·}${X}"; fi          # show a wrong space as ·
    done
    if (( ${#typed} < ${#target} )); then
        out+="${U}${target:${#typed}:1}${X}${D}${target:${#typed}+1}${X}"
    fi
    printf '\r\033[K  %s' "$out"
}

restore_tty() { [ -t 0 ] && stty "$SAVED_TTY" 2>/dev/null; printf '\033[?25h'; }

# ── one round: sets R_WPM R_ACC R_SECS R_LEN ─────────────────────────
round() {
    local target="$1" typed="" key start=0 end keys=0 errors=0 correct=0 i
    SAVED_TTY=$([ -t 0 ] && stty -g || true)
    trap 'restore_tty; echo; exit 130' INT
    [ -t 0 ] && stty -echo -icanon min 1 time 0
    printf '\033[?25l'                              # hide the cursor while typing

    echo "${D}  start typing when ready…${X}"
    paint "$target" ""
    while (( ${#typed} < ${#target} )); do
        IFS= read -rsn1 key || break
        case "$key" in
            $'\e')             restore_tty; echo; echo "  quit."; exit 0 ;;
            $'\x7f'|$'\b')     typed="${typed%?}" ;;
            ''|$'\t')          continue ;;          # Enter / Tab do nothing
            *)
                (( start == 0 )) && start=$(now_us)
                (( keys++ )) || true
                [[ $key == "${target:${#typed}:1}" ]] || (( errors++ )) || true
                typed+="$key"
                ;;
        esac
        paint "$target" "$typed"
    done
    end=$(now_us)
    restore_tty; trap - INT
    echo

    for (( i = 0; i < ${#target}; i++ )); do
        [[ ${typed:i:1} == "${target:i:1}" ]] && (( correct++ )) || true
    done
    (( start == 0 )) && start=$end
    local us=$(( end - start )); (( us < 1 )) && us=1
    # WPM = (correct chars / 5) per minute, kept x10 for one decimal place
    R_WPM=$(( correct * 600000000 * 2 / 5 / us ))
    R_WPM=$(( (R_WPM + 1) / 2 ))
    R_ACC=$(( keys > 0 ? (keys - errors) * 100 / keys : 0 ))
    R_SECS=$(( us / 100000 ))                       # x10
    R_LEN=${#target}
}

fmt1() { printf '%d.%d' $(( $1 / 10 )) $(( $1 % 10 )); }   # 523 -> 52.3

best_wpm() {
    # all-time best wpm x10 (0 if none)
    [ -s "$LOGFILE" ] || { echo 0; return; }
    awk -F'\t' '{w=$2*10; if (w>b) b=w} END {printf "%d\n", b+0}' "$LOGFILE"
}

rating() {
    local w=$(( $1 / 10 ))
    if   (( w >= 90 )); then echo "⚡ blazing"
    elif (( w >= 70 )); then echo "🔥 fast"
    elif (( w >= 50 )); then echo "👍 solid"
    elif (( w >= 30 )); then echo "🙂 getting there"
    else                     echo "🐢 warming up"
    fi
}

play() {
    # $1 rounds, $2 optional fixed text
    local rounds="$1" text="${2:-}" n target prev_best sum=0
    for (( n = 1; n <= rounds; n++ )); do
        target="${text:-$(pick_sentence)}"
        prev_best=$(best_wpm)
        echo
        (( rounds > 1 )) && echo "${M}  round $n/$rounds${X}"
        round "$target"
        printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" \
            "$(fmt1 "$R_WPM")" "$R_ACC" "$(fmt1 "$R_SECS")" "$R_LEN" >> "$LOGFILE"
        echo
        printf "  ${C}%s wpm${X} · ${Y}%s%% accuracy${X} · %ss · %s\n" \
            "$(fmt1 "$R_WPM")" "$R_ACC" "$(fmt1 "$R_SECS")" "$(rating "$R_WPM")"
        if (( R_WPM > prev_best && prev_best > 0 )); then
            echo "  ${G}🎉 new best! (was $(fmt1 "$prev_best"))${X}"
        fi
        sum=$(( sum + R_WPM ))
    done
    (( rounds > 1 )) && printf "\n  ${M}average: %s wpm over %d rounds${X}\n" "$(fmt1 $(( sum / rounds )))" "$rounds"
    return 0
}

spark() {
    # numbers on stdin -> one bar per value, scaled to the min..max range
    awk 'BEGIN { split("▁ ▂ ▃ ▄ ▅ ▆ ▇ █", b, " ") }
         { v[NR]=$1; if (NR==1 || $1<lo) lo=$1; if ($1>hi) hi=$1 }
         END { for (i=1; i<=NR; i++) { k = (hi>lo) ? int((v[i]-lo)/(hi-lo)*7)+1 : 4; printf "%s", b[k] }
               print "" }'
}

stats() {
    [ -s "$LOGFILE" ] || { echo "No rounds yet. Run: typer"; return; }
    local today; today=$(date '+%Y-%m-%d')
    awk -F'\t' -v d="$today" '
        { n++; w+=$2; a+=$3; if ($2>b) b=$2 }
        $1 ~ d { tn++; tw+=$2; ta+=$3; if ($2>tb) tb=$2 }
        END {
            if (tn) printf "today     %d rounds · avg %.1f wpm · best %.1f · %d%% acc\n", tn, tw/tn, tb, ta/tn
            else    print  "today     no rounds yet"
            printf "all time  %d rounds · avg %.1f wpm · best %.1f · %d%% acc\n", n, w/n, b, a/n
        }' "$LOGFILE"
    printf 'last 20   %s  ' "$(tail -20 "$LOGFILE" | cut -f2 | spark)"
    tail -20 "$LOGFILE" | cut -f2 | awk 'NR==1{f=$1} {l=$1} END{printf "(%s → %s wpm)\n", f, l}'
}

# ── dispatcher ───────────────────────────────────────────────────────
case "${1:-}" in
    -h|--help) usage ;;
    "")        play 1 ;;
    -t|--text) [ -n "${2:-}" ] || usage 1 >&2; play 1 "$2" ;;
    best)
        [ -s "$LOGFILE" ] || { echo "No rounds yet. Run: typer"; exit 0; }
        { printf 'DATE\tWPM\tACC%%\tSECS\tCHARS\n'; sort -t$'\t' -k2 -rn "$LOGFILE" | head -10; } \
            | column -t -s $'\t'
        ;;
    stats) stats ;;
    log)
        [ -s "$LOGFILE" ] || { echo "No rounds yet. Run: typer"; exit 0; }
        { printf 'DATE\tWPM\tACC%%\tSECS\tCHARS\n'; tail -20 "$LOGFILE"; } | column -t -s $'\t'
        ;;
    *)
        if [[ $1 =~ ^[0-9]+$ ]] && (( $1 > 0 )); then play "$1"
        else echo "unknown subcommand: $1" >&2; usage 1 >&2; fi
        ;;
esac
